# === Cuadra Erre - Environment Variables ===
# Copia este archivo a .env y rellena tus valores locales.
# NUNCA commitees el archivo .env al repositorio.

# Entorno: development | production
ENVIRONMENT=development

# PostgreSQL
USE_POSTGRES=True
DB_NAME=cuadra_erre
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5432

# Seguridad Django
DJANGO_SECRET_KEY=genera-una-clave-con-python-c-"from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# SMTP (Gmail)
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password_aqui

# Frontend URL (para CORS en producción)
FRONTEND_URL=http://localhost:3000

# === Solo producción (ENVIRONMENT=production) ===
# Hosts permitidos, separados por coma (sin esquema): IP del servidor o dominio
ALLOWED_HOSTS=203.0.113.10

# Orígenes de confianza para CSRF, separados por coma (CON esquema)
CSRF_TRUSTED_ORIGINS=http://203.0.113.10

# Mientras no haya HTTPS/dominio, deben quedar en False; pasar a True
# cuando se active Let's Encrypt en Traefik
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Redis (cache/Celery futuro)
REDIS_URL=redis://redis:6379/0

# === Solo para el contenedor de Postgres en docker-compose ===
# Deben coincidir con DB_NAME / DB_USER / DB_PASSWORD de arriba
POSTGRES_DB=cuadra_erre
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_aqui
